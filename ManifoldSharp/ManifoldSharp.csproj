<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>ManifoldSharp</RootNamespace>
    <AssemblyName>ManifoldSharp</AssemblyName>
    <!-- The whole point of this assembly is that it is pure managed code: no
         P/Invoke, no native artifact, no reflection. That is what lets it run on
         browser-wasm with no emcc link step, so keep it trim- and AOT-clean. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one and only dependency the port is allowed (CLAUDE.md's
         dependency table): Clipper2Lib, confined to CrossSection.Clipper.cs as the
         Rust confines clipper2-rust to cross_section.rs. Everything else is BCL-only.

         Version pinned to 1.5.4 because that is the *same* upstream Clipper2 release
         the Rust side runs: clipper2-rust 1.0.3 reports CLIPPER2_VERSION "1.5.4" (its
         version.rs). Do not float this without re-running the differential harness
         against the Rust — a version skew here is a silent numerical divergence, not
         a build break. (2.0.0 was checked and behaves identically to 1.5.4 on the one
         constant that matters below, so it buys nothing here.)

         Matching version numbers alone do NOT make the two ports numerically
         identical: Clipper2Lib's ClipperD sets its internal scale to 10^precision,
         while upstream C++ (issue #25) and therefore clipper2-rust use
         2^(ilogb(10^precision)+1) — 2^20 rather than 10^6 at our precision of 6 —
         which snapped boolean results to different grids. Resolved in
         CrossSection.Clipper.cs, which scales to Paths64 at the power-of-two scale
         itself and calls Clipper2Lib's integer overloads, bypassing ClipperD. The
         differential harness against the compiled manifold-rust is 101/101
         bit-identical with that in place. Only the booleans need it; InflatePaths,
         Minkowski.Sum and SimplifyPaths scale by 10^decimals on both sides.

         Clipper2Lib is pure managed with no native asset, so the wasm/AOT promise
         above survives it.

         The brackets are what carries the pin past packaging: a plain 1.5.4 packs as
         ">= 1.5.4", so a consumer who also references Clipper2 2.x would float this
         dependency to it and silently lose the numerical agreement the paragraphs above
         describe. "[1.5.4]" makes that case a NU1107 version conflict the consumer has
         to resolve deliberately instead. -->
    <PackageReference Include="Clipper2" Version="[1.5.4]" />
  </ItemGroup>

  <!--
    Pack settings. There is no native staging machinery here and there never will
    be: the package is one managed assembly plus its single managed dependency,
    which is the whole reason this port exists. It supersedes the ManifoldRust
    package for consumers; ManifoldRust stays behind only as this repository's
    test oracle.
  -->
  <PropertyGroup>
    <PackageId>ManifoldSharp</PackageId>
    <!-- This package's version is its own line, not a continuation of
         ManifoldRust's 0.x - the two are different implementations that happen to
         produce the same bits, so their version numbers say nothing about each
         other. 0.x is the README's "no API-stability promise yet" stated in the
         one place a consumer's package manager will show it. -->
    <Version>0.1.0</Version>
    <Authors>Lars Brubaker</Authors>
    <Company>Lars Brubaker</Company>
    <Copyright>Copyright 2026 Lars Brubaker</Copyright>
    <Description>The pure managed C# port of the Manifold geometry kernel, ported line for line from manifold-rust and bit-exact against it: booleans (union / difference / intersection), CSG trees, cross-sections, hulls, Minkowski sums, level sets and mesh repair, with both the exact engine and the robust engine that accepts real-world triangle soup. No native library, no P/Invoke, so it runs anywhere .NET does including browser-wasm.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/larsbrubaker/manifold-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/larsbrubaker/manifold-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>manifold;geometry;csg;boolean;mesh;3d;wasm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repository README is the package README; nuget.org requires it to be
         packed at the root of the package. Its relative links are written as
         absolute github.com URLs for exactly this reason - nuget.org has no
         repository to resolve them against. -->
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rust's `pub(crate)` becomes `internal` here, so a good part of the port -
         Timing's stage timers first - is assembly-visible rather than public. The
         Rust tests are in-crate and see all of it; without this the C# suite could
         only reach the public surface, which is the smaller half. -->
    <InternalsVisibleTo Include="ManifoldSharp.Tests" />
  </ItemGroup>

</Project>
