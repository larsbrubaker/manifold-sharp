<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ManifoldSharp.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.63.0" />
    <PackageReference Include="TUnit.Engine" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManifoldSharp\ManifoldSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 20 Thingi10K meshes the Rust robust suite runs on (src/robust/testdata).
         Test content only, never packaged; a glob so adding a fixture is a copy and
         not also a project edit. They are consumed from Phase 10 onward. -->
    <Content Include="TestData/thingi10k/*.stl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The 17 OBJ regression models the C++ BooleanComplex suite loads with
         ReadTestOBJ (manifold-rust reads them straight out of its cpp-reference
         submodule; this port keeps no such dependency, so they are checked in —
         see ManifoldTestHelpers.ReadTestObj). Test content only, never packaged;
         a glob so adding a model is a copy and not also a project edit. -->
    <Content Include="TestData/models/*.obj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
